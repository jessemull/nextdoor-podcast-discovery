# systemd unit for the Nextdoor recompute worker (Save & Recompute / Activate in UI).
#
# Processes recompute_final_scores only. Permalink jobs are handled by
# nextdoor-permalink-worker. Install both with: sudo ./scripts/install-worker-service.sh
#
# Check status: sudo systemctl status nextdoor-worker
# Logs: journalctl -u nextdoor-worker -f

[Unit]
Description=Nextdoor recompute worker (final scores)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nextdoor
Group=nextdoor
WorkingDirectory=/home/nextdoor/nextdoor/scraper
EnvironmentFile=/home/nextdoor/nextdoor/scraper/.env
ExecStart=/home/nextdoor/nextdoor/.venv/bin/python -m src.worker --job-type recompute_final_scores
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
