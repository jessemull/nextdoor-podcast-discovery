# Nextdoor Scraper Environment Variables
# Copy to .env and fill in. Local dev: use dev Supabase. Server (production): use prod Supabase only. See docs/ENVIRONMENTS.md.

NEXTDOOR_EMAIL=your-email@example.com
NEXTDOOR_PASSWORD=your-password

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-key...

# Generate from repo root: make gen-key
SESSION_ENCRYPTION_KEY=your-fernet-key

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Production server only: app URL and secret for worker → cache invalidation after activate
# APP_URL=https://yourdomain.com
# INTERNAL_API_SECRET=your-secret

# Optional: rotating logs (e.g. on server)
# SCRAPER_LOG_DIR=~/nextdoor-logs
# UNSCORED_BATCH_LIMIT=100
