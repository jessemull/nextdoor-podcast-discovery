# NextDoor Credentials

NEXTDOOR_EMAIL=your-email@example.com
NEXTDOOR_PASSWORD=your-password

# Supabase

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-key...

# Compare prod vs dev scoring: scripts/compare_env_scores.py, make compare-env-scores

COMPARE_PROD_SUPABASE_URL=https://xxxx.supabase.co
COMPARE_PROD_SUPABASE_SERVICE_KEY=eyJ...
COMPARE_DEV_SUPABASE_URL=https://yyyy.supabase.co
COMPARE_DEV_SUPABASE_SERVICE_KEY=eyJ...

# Session Key

SESSION_ENCRYPTION_KEY=your-fernet-key

# LLMs

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
CLAUDE_MODEL=claude-haiku-4-5

# Internal

APP_URL=https://yourdomain.com
INTERNAL_API_SECRET=your-random-secret-match-server-scraper-env
SCRAPER_DEBUG_SCROLL_ONLY=0
SCRAPER_LOG_DIR=~/nextdoor-logs
UNSCORED_BATCH_LIMIT=100
