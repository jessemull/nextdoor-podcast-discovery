# Web Dashboard Environment Variables
# Copy to .env.local and fill in. For dev vs prod (Vercel Preview/Production) see docs/ENVIRONMENTS.md.

# Supabase — use dev project for local/Preview; prod project for Vercel Production
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...your-service-key...

# Auth0 — one app; add both Preview and Production callback/logout URLs in Auth0 dashboard
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_SECRET=generate-a-random-secret-per-environment
APP_BASE_URL=http://localhost:3000

# Optional
# AUTH0_SESSION_STORE_ID_TOKEN=false
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# INTERNAL_API_SECRET=  # Production: set same value as server scraper/.env when using worker cache invalidation

# Redis (recommended for Vercel; keys are namespaced by env so one DB can serve Preview + Production)
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXX...
